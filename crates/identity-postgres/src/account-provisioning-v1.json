{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "action",
    "tenant",
    "principal",
    "actor",
    "epoch",
    "state",
    "actor_tenant",
    "actor_instance"
  ],
  "properties": {
    "action": {
      "const": "account_created"
    },
    "tenant": {
      "type": "string",
      "format": "uuid"
    },
    "principal": {
      "type": "string",
      "format": "uuid"
    },
    "actor": {
      "type": "string",
      "format": "uuid"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "member_active",
        "membership_epoch"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "member_active": {
          "type": "boolean"
        },
        "membership_epoch": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "actor_tenant": {
      "type": "string",
      "format": "uuid"
    },
    "actor_instance": {
      "type": "string",
      "format": "uuid"
    }
  }
}
